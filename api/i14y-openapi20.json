{
  "swagger": "2.0",
  "info": {
    "title": "IRIS Interoperability Production Explainer API",
    "version": "0.1.0",
    "description": "Discover and explain InterSystems IRIS interoperability productions in the current namespace."
  },
  "basePath": "/i14y-aid/api",
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/_spec": {
      "get": {
        "summary": "Get OpenAPI spec",
        "operationId": "GetSpec",
        "responses": {
          "200": {
            "description": "Swagger spec JSON",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Get module health and capabilities",
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "Module health",
            "schema": {
              "$ref": "#/definitions/HealthResponse"
            }
          }
        }
      }
    },
    "/settings": {
      "get": {
        "summary": "Get module analysis settings",
        "operationId": "GetSettings",
        "responses": {
          "200": {
            "description": "Module analysis settings",
            "schema": {
              "$ref": "#/definitions/SettingsResponse"
            }
          }
        }
      }
    },
    "/productions": {
      "get": {
        "summary": "List interoperability productions in the current namespace",
        "operationId": "ListProductions",
        "responses": {
          "200": {
            "description": "Production list",
            "schema": {
              "$ref": "#/definitions/ProductionListResponse"
            }
          }
        }
      }
    },
    "/messages": {
      "get": {
        "summary": "List recent interoperability message headers",
        "operationId": "ListMessages",
        "parameters": [
          {
            "name": "productionName",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 50
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          {
            "name": "sourceConfigName",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "targetConfigName",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "messageBodyClassName",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "sessionId",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "errorsOnly",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": false
          }
